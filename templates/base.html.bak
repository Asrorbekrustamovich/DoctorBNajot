{% load static %}
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Doctor B Najot{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>
    <style>
        :root {
            --brand: #0d9488;
            --brand-dark: #0f766e;
            --brand-light: #ccfbf1;
            --ink: #0f172a;
            --muted: #64748b;
        }
        body { font-family: 'Inter', system-ui, sans-serif; background: #f1f5f9; color: var(--ink); }
        .navbar-dbn { background: #ffffff; box-shadow: 0 1px 12px rgba(15,23,42,.08); }
        .navbar-dbn .navbar-brand { font-weight: 800; letter-spacing: -.3px; color: var(--brand-dark); }
        .navbar-dbn .brand-badge {
            width: 38px; height: 38px;
            background: linear-gradient(135deg, var(--brand), #0ea5e9);
            border-radius: 10px; display: inline-flex; align-items: center; justify-content: center;
            color: #fff; font-size: 1.15rem; margin-right: .55rem;
        }
        .navbar-dbn .nav-link { color: var(--muted); font-weight: 600; border-radius: 8px; padding: .45rem .9rem; margin: 0 .1rem; }
        .navbar-dbn .nav-link:hover { color: var(--brand-dark); background: var(--brand-light); }
        .card { border: 0; border-radius: 14px; box-shadow: 0 1px 10px rgba(15,23,42,.06); }
        .card-header { background: #fff; border-bottom: 1px solid #eef2f7; font-weight: 700; border-radius: 14px 14px 0 0 !important; }
        .btn-primary { background: var(--brand); border-color: var(--brand); font-weight: 600; border-radius: 9px; }
        .btn-primary:hover, .btn-primary:focus { background: var(--brand-dark); border-color: var(--brand-dark); }
        .btn-outline-primary { color: var(--brand-dark); border-color: var(--brand); border-radius: 9px; font-weight: 600; }
        .btn-outline-primary:hover { background: var(--brand); border-color: var(--brand); }
        .form-control, .form-select { border-radius: 9px; border-color: #e2e8f0; padding: .55rem .8rem; }
        .form-control:focus, .form-select:focus { border-color: var(--brand); box-shadow: 0 0 0 .2rem rgba(13,148,136,.15); }
        .table thead th { font-size: .78rem; text-transform: uppercase; letter-spacing: .4px; color: var(--muted); border-bottom-width: 1px; }
        .badge { font-weight: 600; border-radius: 7px; padding: .4em .65em; }
        .stat-card { transition: transform .15s ease; }
        .stat-card:hover { transform: translateY(-3px); }
        .stat-icon { width: 52px; height: 52px; border-radius: 13px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.4rem; }
        .page-title { font-weight: 800; letter-spacing: -.4px; }
    </style>
    {% block extra_head %}{% endblock %}
</head>
<body hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}'>
{% if user.is_authenticated %}
<nav class="navbar navbar-expand-lg navbar-dbn sticky-top">
    <div class="container-fluid px-4">
        <a class="navbar-brand d-flex align-items-center" href="{% url 'core:home' %}">
            <span class="brand-badge"><i class="bi bi-heart-pulse-fill"></i></span>
            Doctor B Najot
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto ms-3">
                {% if user.role.code != "accountant" %}
                <li class="nav-item">
                    <a class="nav-link" href="{% url 'core:home' %}"><i class="bi bi-grid-1x2"></i> Panel</a>
                </li>
                {% endif %}
                {% if user.is_superuser or user.role.code == "administrator" or user.role.code == "reception" or user.role.code == "director" or user.role.code == "chief_doctor" or user.role.code == "cashier" %}
                <li class="nav-item">
                    <a class="nav-link" href="{% url 'patients:list' %}"><i class="bi bi-people"></i> Bemorlar</a>
                </li>
                {% endif %}
                {% if user.can_view_visits and user.role.code != "accountant" %}
                <li class="nav-item">
                    <a class="nav-link" href="{% url 'registration:queue' %}"><i class="bi bi-list-ol"></i> Navbat</a>
                </li>
                {% endif %}

                {% if user.is_superuser or user.role.code == "doctor" or user.role.code == "chief_doctor" %}
                <li class="nav-item">
                    <a class="nav-link" href="{% url 'clinical:my_templates' %}"><i class="bi bi-file-earmark-richtext"></i> Shablonlarim</a>
                </li>
                {% endif %}
                
                {% if user.is_superuser or user.role.code == "doctor" or user.role.code == "chief_doctor" or user.role.code == "radiology" or user.role.code == "lab" %}
                <li class="nav-item">
                    <a class="nav-link text-info fw-bold" href="{% url 'clinical:examiner_dashboard' %}"><i class="bi bi-clipboard2-pulse"></i> Mutaxassis Paneli</a>
                </li>
                {% endif %}
                
                {% if user.is_superuser or user.role.code in "administrator,reception,director,chief_doctor,doctor,surgeon,nurse,ward_nurse" %}
                <li class="nav-item">
                    <a class="nav-link" href="{% url 'clinical:inpatient_dashboard' %}"><i class="bi bi-hospital"></i> Stasionar</a>
                </li>
                {% endif %}
                
                {% if user.is_superuser or user.role.code == "administrator" or user.role.code == "super_admin" %}
                <li class="nav-item">
                    <a class="nav-link" href="{% url 'clinical:surgery_admin_list' %}"><i class="bi bi-list-check"></i> Jarrohlik ro'yxati</a>
                </li>
                {% endif %}
                
                {% if user.is_superuser or user.role.code == "sterilization" %}
                <li class="nav-item">
                    <a class="nav-link" href="{% url 'clinical:sterilization_dashboard' %}"><i class="bi bi-shield-plus"></i> Avtoklav</a>
                </li>
                {% endif %}
                
                {% if user.is_superuser or user.role.code == "surgeon" or user.role.code == "administrator" or user.role.code == "super_admin" %}
                <li class="nav-item">
                    <a class="nav-link" href="{% url 'clinical:surgery_dashboard' %}"><i class="bi bi-heart-pulse"></i> Jarrohlik (Boshqaruv)</a>
                </li>
                {% endif %}
                
                {% if user.is_superuser or user.role.code == "cashier" or user.role.code == "accountant" or user.role.code == "director" or user.role.code == "super_admin" %}
                <li class="nav-item">
                    <a class="nav-link fw-bold text-success" href="{% url 'billing:dashboard' %}"><i class="bi bi-cash-coin"></i> Kassa (Hisob)</a>
                </li>
                {% endif %}
                
                {% if user.is_superuser or user.role.code == "warehouse" or user.role.code == "super_admin" %}
                <li class="nav-item">
                    <a class="nav-link" href="{% url 'pharmacy:dashboard' %}"><i class="bi bi-box-seam"></i> Ombor (Sklad)</a>
                </li>
                {% endif %}

                {% if user.is_superuser or user.role.code == "sterilization" %}
                <li class="nav-item">
                    <a class="nav-link text-warning" href="{% url 'clinical:autoclave_dashboard' %}"><i class="bi bi-droplet-half"></i> Avtoklav Paneli</a>
                </li>
                {% endif %}

                {% if user.is_superuser or user.role.code == "director" or user.role.code == "administrator" or user.role.code == "super_admin" %}
                <li class="nav-item">
                    <a class="nav-link" href="{% url 'billing:doctor_prices' %}"><i class="bi bi-cash-stack"></i> Qabul narxlari</a>
                </li>
                {% endif %}

                {% if user.is_superuser or user.role.code == "director" or user.role.code == "accountant" or user.role.code == "super_admin" %}
                <li class="nav-item">
                    <a class="nav-link fw-bold text-primary" href="{% url 'billing:revenue_report' %}"><i class="bi bi-graph-up-arrow"></i> Hisobot</a>
                </li>
                {% endif %}

                {% if user.is_superuser or user.role.code == "super_admin" %}
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-gear-fill"></i> Sozlamalar
                    </a>
                    <ul class="dropdown-menu shadow border-0" style="border-radius:12px">
                        <li>
                            <a class="dropdown-item" href="{% url 'staff:list' %}">
                                <i class="bi bi-people me-2 text-primary"></i> Xodimlar boshqaruvi
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="{% url 'staff:services' %}">
                                <i class="bi bi-grid-3x3-gap me-2 text-info"></i> Xizmatlar katalogi
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="{% url 'clinical:rooms_settings' %}">
                                <i class="bi bi-hospital me-2 text-success"></i> Palatalar boshqaruvi
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="{% url 'clinical:service_settings' %}">
                                <i class="bi bi-clipboard2-pulse me-2 text-primary"></i> Xizmatlar boshqaruvi
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="{% url 'clinical:surgery_settings' %}">
                                <i class="bi bi-heart-pulse me-2 text-danger"></i> Jarrohlik boshqaruvi
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="{% url 'clinical:autoclave_settings' %}">
                                <i class="bi bi-shield-check me-2 text-warning"></i> Avtoklav boshqaruvi
                            </a>
                        </li>
                    </ul>
                </li>
                {% endif %}

                {% block nav_items %}{% endblock %}
            </ul>
            <ul class="navbar-nav">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle me-2 fs-5"></i>
                        <span>
                            {{ user.get_full_name|default:user.username }}
                            {% if user.role %}<small class="d-block text-muted" style="font-size:.72rem">{{ user.role.name }}</small>{% endif %}
                        </span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius:12px">
                        <li><a class="dropdown-item" href="{% url 'audit:my_activity' %}"><i class="bi bi-clock-history"></i> Mening ishlarim</a></li>
                        <li><hr class="dropdown-divider"></li>
                        {% if user.is_staff %}
                        <li><a class="dropdown-item" href="/admin/"><i class="bi bi-gear"></i> Boshqaruv</a></li>
                        <li><hr class="dropdown-divider"></li>
                        {% endif %}
                        <li>
                            <form method="post" action="{% url 'accounts:logout' %}">
                                {% csrf_token %}
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right"></i> Chiqish
                                </button>
                            </form>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>
{% endif %}
<main class="container-fluid py-4 px-4">
    {% if messages %}
        {% for message in messages %}
            <div class="alert alert-{{ message.tags|default:'info' }} alert-dismissible fade show" style="border-radius:12px">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endif %}
    {% block content %}{% endblock %}
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block extra_js %}{% endblock %}
</body>
</html>
