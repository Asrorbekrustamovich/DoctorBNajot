# ============================================================
# Doctor B Najot — HIS. Server (production) uchun namuna .env
# Nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring.
# ============================================================

# --- Asosiy ---
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=BU-YERGA-UZUN-TASODIFIY-MAXFIY-KALIT
DEBUG=False
ALLOWED_HOSTS=doctorbnajot.uz,www.doctorbnajot.uz

# --- Vaqt mintaqasi ---
TIME_ZONE=Asia/Tashkent

# --- Ma'lumotlar bazasi (PostgreSQL) ---
# DIQQAT: paroldagi maxsus belgilar URL uchun KODLANISHI shart:
#   /  -> %2F     +  -> %2B     =  -> %3D     @  -> %40     :  -> %3A
# Kodlangan parolni olish:
#   python -c "from urllib.parse import quote; print(quote(input(), safe=''))"
DATABASE_URL=postgres://foydalanuvchi:parol@localhost:5432/edumed_his

# Masofadagi (internetdagi) baza uchun:
# DB_SSLMODE=require        # server SSL qo'llamasa: disable
# DB_CONNECT_TIMEOUT=10
# DB_CONN_MAX_AGE=300

# --- Redis (kesh + Celery navbat) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- CORS (API'ni tashqi frontend/mobil ilovadan chaqirish) ---
CORS_ALLOWED_ORIGINS=https://app.doctorbnajot.uz
# CORS_ALLOW_ALL_ORIGINS=False

# --- HTTPS xavfsizligi ---
SECURE_SSL_REDIRECT=True
CSRF_TRUSTED_ORIGINS=https://doctorbnajot.uz,https://www.doctorbnajot.uz
